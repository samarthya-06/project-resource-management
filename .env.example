DJANGO_SECRET_KEY=replace-with-a-generated-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=project_resource
DB_USER=project_user
DB_PASSWORD=replace-with-your-local-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Render: use its Internal Database URL (append ?sslmode=require).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Render supplies RENDER_EXTERNAL_HOSTNAME automatically.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-custom-domain.example
# DJANGO_SECURE_HSTS_SECONDS=3600
# Only required for the explicit development-only seed_demo command.
DEMO_PASSWORD=replace-with-a-strong-demo-password
